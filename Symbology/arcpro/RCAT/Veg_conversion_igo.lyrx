        "isDefaultSymbolVisible" : true,
        "valueExpressionInfo" : {
          "type" : "CIMExpressionInfo",
          "title" : "Custom",
          "expression" : "var conversionCode = $feature.ConversionCode;\n\nif (IndexOf([29, 30, 31, 32], conversionCode) > -1) {\n    return \"Conifer Encroachment\";\n} else if (IndexOf([41, 42, 43, 44], conversionCode) > -1) {\n    return \"Conv. To Agriculture\";\n} else if (IndexOf([21, 22, 23, 24], conversionCode) > -1) {\n    return \"Conv. To Grass/Shrubland\";\n} else if (IndexOf([33, 34, 35, 36], conversionCode) > -1) {\n    return \"Conv. To Invasive\";\n} else if (IndexOf([45, 46, 47, 48], conversionCode) > -1) {\n    return \"Non-Riparian Conversions\";\n} else if (IndexOf([25, 26, 27, 28], conversionCode) > -1) {\n    return \"Devegetation\";\n} else if (IndexOf([37, 38, 39, 40], conversionCode) > -1) {\n    return \"Development\";\n} else if (IndexOf([49, 50, 51, 52], conversionCode) > -1) {\n    return \"Multiple Conv. Types\";\n} else if (IndexOf([0], conversionCode) > -1) {\n    return \"Negligible to Minor Veg Conversion\";\n} else if (IndexOf([9, 10, 11, 12], conversionCode) > -1) {\n    return \"From Grass/Shrubland to Riparian\";\n} else if (IndexOf([5, 6, 7, 8], conversionCode) > -1) {\n    return \"From Devegetated to Riparian\";\n} else if (IndexOf([1, 2, 3, 4], conversionCode) > -1) {\n    return \"From Conifer to Riparian\";\n} else {\n    return \"Other\";\n}\n",
          "returnType" : "Default"
        },
        "polygonSymbolColorTarget" : "Fill"
      },
      "scaleSymbols" : true,
      "snappable" : true
    }
