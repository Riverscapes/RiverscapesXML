{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    [
      "rgb(255,200,0)",
      "Low Hazard"
    ],
    [
      "rgb(255,120,0)",
      "Medium Hazard"
    ],
    [
      "rgb(220,0,0)",
      "High Hazard"
    ]
  ],
  "layerStyles": [
    {
      "id": "flood-hazard-fill",
      "type": "fill",
      "source": "composite",
      "source-layer": "flood_hazard",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "hazard_class"
          ],
          [
            "Low"
          ],
          "rgb(255,200,0)",
          [
            "Medium"
          ],
          "rgb(255,120,0)",
          [
            "High"
          ],
          "rgb(220,0,0)",
          "rgb(192,177,0)"
        ],
        "fill-opacity": 0.6
      }
    },
    {
      "id": "flood-hazard-line",
      "type": "line",
      "source": "composite",
      "source-layer": "flood_hazard",
      "paint": {
        "line-color": "rgb(35,35,35)",
        "line-width": 0.5
      }
    }
  ]
}
