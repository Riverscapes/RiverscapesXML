{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["rgb(201, 221, 226)", "Complex"]
  ],
  "layerStyles": [
    {
      "id": "complexes-fill",
      "type": "fill",
      "source": "composite",
      "source-layer": "complexes",
      "layout": {},
      "paint": {
        "fill-color": "rgb(201, 221, 226)",
        "fill-opacity": 0.25,
        "fill-outline-color": "rgba(0,0,0,0)"
      }
    },
    {
      "id": "complexes-line",
      "type": "line",
      "source": "composite",
      "source-layer": "complexes",
      "layout": {},
      "paint": {
        "line-color": "rgb(255, 0, 0)",
        "line-width": 1.5,
        "line-dasharray": [4, 2]
      }
    }
  ]
}
