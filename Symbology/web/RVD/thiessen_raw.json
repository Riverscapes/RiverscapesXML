{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    [
      "rgb(231,207,72)",
      "Thiessen Raw"
    ]
  ],
  "layerStyles": [
    {
      "id": "thiessen_raw-fill",
      "type": "fill",
      "source": "composite",
      "source-layer": "thiessen_raw",
      "paint": {
        "fill-color": "rgb(231,207,72)",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "thiessen_raw-line",
      "type": "line",
      "source": "composite",
      "source-layer": "thiessen_raw",
      "paint": {
        "line-color": "rgb(231,207,72)",
        "line-width": 1
      }
    }
  ]
}
