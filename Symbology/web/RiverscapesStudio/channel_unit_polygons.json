{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["rgb(105, 232, 202)", "Concavity"],
    ["rgb(238, 47, 91)", "Convexity"],
    ["rgb(127, 148, 215)", "Planar"],
    ["rgb(206, 182, 103)", "Pond"],
    ["rgb(238, 27, 76)", "NA"],
    ["rgb(192, 177, 0)", "Unclassified"]
  ],
  "layerStyles": [
    {
      "id": "channel-unit-polygons-fill",
      "type": "fill",
      "source": "composite",
      "source-layer": "channel_unit_polygons",
      "layout": {},
      "paint": {
        "fill-color": [
          "match",
          ["get", "unit_type"],
          [1], "rgb(105, 232, 202)",
          [2], "rgb(238, 47, 91)",
          [3], "rgb(127, 148, 215)",
          [4], "rgb(206, 182, 103)",
          [5], "rgb(238, 27, 76)",
          "rgb(192, 177, 0)"
        ],
        "fill-opacity": 0.45,
        "fill-outline-color": "rgba(0, 0, 0, 0)"
      }
    },
    {
      "id": "channel-unit-polygons-line",
      "type": "line",
      "source": "composite",
      "source-layer": "channel_unit_polygons",
      "layout": {},
      "paint": {
        "line-color": "rgb(255, 255, 255)",
        "line-width": 1,
        "line-dasharray": [2, 2]
      }
    }
  ]
}
