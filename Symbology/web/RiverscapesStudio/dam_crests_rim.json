{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["rgb(215, 25, 28)", "Blown Out"],
    ["rgb(255, 141, 35)", "Breached"],
    ["rgb(30, 238, 44)", "Intact"],
    ["rgb(192, 177, 0)", "null"]
  ],
  "layerStyles": [
    {
      "id": "dam-crests-rim",
      "type": "line",
      "source": "composite",
      "source-layer": "dam_crests_rim",
      "layout": {},
      "paint": {
        "line-color": [
          "match",
          ["get", "dam_state"],
          ["Blown Out"], "rgb(215, 25, 28)",
          ["Breached"], "rgb(255, 141, 35)",
          ["Intact"], "rgb(30, 238, 44)",
          "rgb(192, 177, 0)"
        ],
        "line-width": 2,
        "line-dasharray": [1, 2]
      }
    }
  ]
}
