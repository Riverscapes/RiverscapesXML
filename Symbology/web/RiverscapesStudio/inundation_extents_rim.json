{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["rgb(255, 0, 197)", "Free Flowing"],
    ["rgb(0, 230, 169)", "Overflow"],
    ["rgb(0, 112, 255)", "Ponded"],
    ["rgb(192, 177, 0)", "null"]
  ],
  "layerStyles": [
    {
      "id": "inundation-extents-rim-line",
      "type": "line",
      "source": "composite",
      "source-layer": "inundation_extents_rim",
      "layout": {},
      "paint": {
        "line-color": [
          "match",
          ["get", "Type"],
          ["Free Flowing"], "rgb(162, 0, 132)",
          ["Overflow"], "rgb(2, 134, 102)",
          ["Ponded"], "rgb(0, 50, 240)",
          "rgb(35, 35, 35)"
        ],
        "line-width": 1.5,
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "inundation-extents-rim-fill",
      "type": "fill",
      "source": "composite",
      "source-layer": "inundation_extents_rim",
      "layout": {},
      "paint": {
        "fill-color": [
          "match",
          ["get", "Type"],
          ["Free Flowing"], "rgb(255, 0, 197)",
          ["Overflow"], "rgb(0, 230, 169)",
          ["Ponded"], "rgb(0, 112, 255)",
          "rgb(192, 177, 0)"
        ],
        "fill-opacity": 0.6,
        "fill-outline-color": "rgba(0, 0, 0, 0)"
      }
    }
  ]
}
