{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    [
      "rgb(200,200,200)",
      "Suburbs"
    ]
  ],
  "layerStyles": [
    {
      "id": "nz-suburbs-fill",
      "type": "fill",
      "source": "composite",
      "source-layer": "nz_suburbs",
      "paint": {
        "fill-color": "rgb(200,200,200)",
        "fill-opacity": 0.3
      }
    },
    {
      "id": "nz-suburbs-line",
      "type": "line",
      "source": "composite",
      "source-layer": "nz_suburbs",
      "paint": {
        "line-color": "rgb(150,150,150)",
        "line-width": 1
      }
    }
  ]
}
