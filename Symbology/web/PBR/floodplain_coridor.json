{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    [
      "rgb(163,217,215)",
      "Floodplain Corridor"
    ]
  ],
  "layerStyles": [
    {
      "id": "floodplain-corridor-fill",
      "type": "fill",
