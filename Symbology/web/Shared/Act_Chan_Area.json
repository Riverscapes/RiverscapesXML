{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["rgb(163, 242, 242)", "Active Channel Area"]
  ],
  "layerStyles": [
    {
      "id": "act-chan-area",
      "type": "fill",
      "source": "composite",
      "source-layer": "Act_Chan_Area",
      "layout": {},
      "paint": {
        "fill-color": [
          "interpolate", ["linear"], ["get", "area"],
          0, "rgb(163, 242, 242)",
          100, "rgb(122, 201, 224)"
        ],
        "fill-opacity": 0.7,
        "fill-outline-color": "rgba(0,0,0,0)"
      }
    }
  ]
}
