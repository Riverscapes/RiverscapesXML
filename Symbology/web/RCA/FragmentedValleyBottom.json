{
  "$schema": "https://xml.riverscapes.xyz/Symbology/web/vector.schema.json",
  "legend": [
    [
      "rgb(255,127,127)",
      "Not connected"
    ],
    [
      "rgb(180,215,158)",
      "Connected"
    ],
    [
      "rgb(240,242,196)",
      "<all other values>"
    ]
  ],
  "layerStyles": [
    {
      "id": "FragmentedValleyBottom-fill",
      "type": "fill",
      "source": "composite",
      "source-layer": "Connected",
      "layout": {},
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "Connected"
          ],
          0,
          "rgb(255,127,127)",
          1,
          "rgb(180,215,158)",
          "",
          "rgb(240,242,196)",
          "rgb(128,128,128)"
        ],
        "fill-opacity": 0.7
      }
    },
    {
      "id": "FragmentedValleyBottom-line",
      "type": "line",
      "source": "composite",
      "source-layer": "Connected",
      "layout": {},
      "paint": {
        "line-color": "rgba(0,0,0,0.2)",
        "line-width": 0.2
      }
    }
  ]
}
