{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["rgb(222, 245, 229)", "Low"],
    ["rgb(116, 180, 140)", "Medium"],
    ["rgb(11, 80, 50)", "High"]
  ],
  "layerStyles": [
    {
      "id": "prop_chan_blm",
      "type": "fill",
      "source": "composite",
      "source-layer": "prop_chan_blm",
      "layout": {},
      "paint": {
        "fill-color": [
          "interpolate", ["linear"], ["get", "blm_prop_chan"],
          0, "rgb(222, 245, 229)",
          0.5, "rgb(116, 180, 140)",
          1, "rgb(11, 80, 50)"
        ],
        "fill-opacity": 0.7
      }
    },
    {"id": "prop_chan_blm-line", "type": "line", "source": "composite",
      "source-layer": "prop_chan_blm", "paint": {"line-width": 0.5}}
  ]
}
