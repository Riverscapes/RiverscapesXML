{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["rgb(255, 255, 204)", "Low"],
    ["rgb(0, 104, 55)", "High"]
  ],
  "layerStyles": [
    {
      "id": "prop_vb_blm",
      "type": "fill",
      "source": "composite",
      "source-layer": "prop_vb_blm",
      "layout": {},
      "paint": {
        "fill-color": [
          "interpolate", ["linear"], ["get", "blm_prop_vb"],
          0, "rgb(255, 255, 204)",
          1, "rgb(0, 104, 55)"
        ],
        "fill-opacity": 0.7
      }
    },
    {"id": "prop_vb_blm-line", "type": "line", "source": "composite",
      "source-layer": "prop_vb_blm", "paint": {"line-width": 0.5}}
  ]
}
