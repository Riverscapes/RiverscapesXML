{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["rgb(253, 231, 37)", "Low"],
    ["rgb(133, 140, 60)", "Medium"],
    ["rgb(68, 1, 84)", "High"]
  ],
  "layerStyles": [
    {
      "id": "prop_rip",
      "type": "fill",
      "source": "composite",
      "source-layer": "prop_rip",
      "layout": {},
      "paint": {
        "fill-color": [
          "interpolate", ["linear"], ["get", "prop_rip"],
          0, "rgb(68, 1, 84)",
          0.5, "rgb(133, 140, 60)",
          1, "rgb(253, 231, 37)"
        ],
        "fill-opacity": 0.7
      }
    },
    {"id": "prop_rip-line", "type": "line", "source": "composite",
      "source-layer": "prop_rip", "paint": {"line-width": 0.5}}
  ]
}
