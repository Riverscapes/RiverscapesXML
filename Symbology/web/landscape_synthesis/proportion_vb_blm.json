{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["rgb(247, 252, 245)", "Low"],
    ["rgb(0, 68, 27)", "High"]
  ],
  "layerStyles": [
    {
      "id": "proportion_vb_blm",
      "type": "fill",
      "source": "composite",
      "source-layer": "proportion_vb_blm",
      "layout": {},
      "paint": {
        "fill-color": [
          "interpolate", ["linear"], ["get", "blm_proportion_vb"],
          0, "rgb(247, 252, 245)",
          1, "rgb(0, 68, 27)"
        ],
        "fill-opacity": 0.7
      }
    },
    {"id": "proportion_vb_blm-line", "type": "line", "source": "composite",
      "source-layer": "proportion_vb_blm", "paint": {"line-width": 0.5}}
  ]
}
