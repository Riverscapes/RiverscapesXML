{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["rgb(247, 251, 255)", "Low density"],
    ["rgb(107, 174, 214)", "Medium density"],
    ["rgb(8, 48, 107)", "High density"]
  ],
  "layerStyles": [
    {
      "id": "drainage_density",
      "type": "fill",
      "source": "composite",
      "source-layer": "drainage_density",
      "layout": {},
      "paint": {
        "fill-color": [
          "interpolate", ["linear"], ["get", "drain_dens"],
          0, "rgb(247, 251, 255)",
          0.5, "rgb(107, 174, 214)",
          1, "rgb(8, 48, 107)"
        ],
        "fill-opacity": 0.7
      }
    },
    {"id": "drainage_density-line", "type": "line", "source": "composite",
      "source-layer": "drainage_density", "paint": {"line-width": 0.5}}
  ]
}
