{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["rgb(68, 1, 84)", "Low"],
    ["rgb(253, 231, 37)", "High"]
  ],
  "layerStyles": [
    {
      "id": "prop_rip_blm",
      "type": "fill",
      "source": "composite",
      "source-layer": "prop_rip_blm",
      "layout": {},
      "paint": {
        "fill-color": [
          "interpolate", ["linear"], ["get", "blm_prop_rip"],
          0, "rgb(68, 1, 84)",
          1, "rgb(253, 231, 37)"
        ],
        "fill-opacity": 0.7
      }
    },
    {"id": "prop_rip_blm-line", "type": "line", "source": "composite",
      "source-layer": "prop_rip_blm", "paint": {"line-width": 0.5}}
  ]
}
