{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["rgb(240, 91, 16)", "Primary"],
    ["rgb(82, 213, 126)", "Non-Primary"]
  ],
  "layerStyles": [
    {
      "id": "thalwegs",
      "type": "line",
      "source": "composite",
      "source-layer": "thalwegs",
      "layout": {},
