{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["rgb(247, 251, 255)", "0%"],
    ["rgb(198, 219, 239)", "0% to 10%"],
    ["rgb(107, 174, 214)", "10% to 25%"],
    ["rgb(33, 113, 181)", "25% to 50%"],
    ["rgb(8, 48, 107)", "> 50%"]
  ],
  "layerStyles": [
    {
      "id": "dgo_prop_channel-fill",
      "type": "fill",
      "source": "composite",
      "source-layer": "dgo_prop_channel",
      "layout": {},
      "paint": {
        "fill-color": [
          "interpolate", ["linear"], ["get", "active_channel_prop"],
          0, "rgb(247, 251, 255)",
          0.1, "rgb(198, 219, 239)",
          0.25, "rgb(107, 174, 214)",
          0.5, "rgb(33, 113, 181)",
          1.0, "rgb(8, 48, 107)"
        ]
      }
    },
    {
      "id": "dgo_prop_channel-line",
      "type": "line",
      "source": "composite",
      "source-layer": "dgo_prop_channel",
      "layout": {},
      "paint": {"line-width": 0.5}
    }
  ]
}
