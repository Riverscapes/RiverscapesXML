{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["rgb(252, 253, 191)", "Moving Window Distance"]
  ],
  "layerStyles": [
    {
      "id": "metric_moving_window_distance",
      "type": "circle",
      "source": "composite",
      "source-layer": "metric_moving_window_distance",
      "layout": {},
      "paint": {
        "circle-color": [
          "interpolate", ["linear"], ["get", "window_size"],
          0, "rgb(0, 0, 4)",
          500, "rgb(126, 126, 97)",
          1000, "rgb(252, 253, 191)"
        ],
        "circle-radius": [
          "interpolate", ["linear"], ["zoom"],
          10, 1.5, 13, 3, 15, 4.5
        ]
      }
    }
  ]
}
