{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["#ffffff", "< 2%"],
    ["#e5ffcd", "2% to 5%"],
    ["#99e29d", "5% to 10%"],
    ["#7bbbcc", "10% to 15%"],
    ["#0868ac", "15% to 25%"],
    ["#070463", "> 25%"]
  ],
  "layerStyles": [
    {
      "id": "metric_prop_activechannel",
      "type": "circle",
      "source": "composite",
      "source-layer": "metric_prop_activechannel",
      "layout": {},
      "paint": {
        "circle-color": [
          "step",
          ["get", "active_channel_proportion"],
          "#ffffff",
          0.02, "#e5ffcd",
          0.05, "#99e29d",
          0.10, "#7bbbcc",
          0.15, "#0868ac",
          0.25, "#070463"
        ],
        "circle-radius": [
          "interpolate", ["linear"], ["zoom"],
          10, 1.5, 13, 3, 15, 4.5
        ]
      }
    }
  ]
}
