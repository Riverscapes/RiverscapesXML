{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["rgb(26, 150, 65)", "0% Elevated"],
    ["rgb(130, 185, 100)", "0% to 25%"],
    ["rgb(200, 220, 100)", "25% to 50%"],
    ["rgb(240, 129, 37)", "50% to 75%"],
    ["rgb(180, 60, 0)", "> 75%"]
  ],
  "layerStyles": [
    {
      "id": "est_prop_vb_elevated",
      "type": "circle",
      "source": "composite",
      "source-layer": "est_prop_vb_elevated",
      "layout": {},
      "paint": {
        "circle-color": [
          "interpolate", ["linear"], ["get", "inactive_floodplain_proportion"],
          0, "rgb(26, 150, 65)",
          0.000002, "rgb(26, 150, 65)",
          0.25, "rgb(130, 185, 100)",
          0.5, "rgb(200, 220, 100)",
          0.75, "rgb(240, 129, 37)",
          1.0, "rgb(180, 60, 0)"
        ],
        "circle-radius": [
          "interpolate", ["linear"], ["zoom"],
          10, 1.5, 13, 3, 15, 4.5
        ]
      }
    }
  ]
}
