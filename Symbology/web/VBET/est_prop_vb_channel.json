{
  "$schema": "https://xml.riverscapes.net/Symbology/web/vector.schema.json",
  "legend": [
    ["#ffffff", "0%"],
    ["#e5ffcd", "0% to 10%"],
    ["#99e29d", "10% to 25%"],
    ["#7bbbcc", "25% to 50%"],
    ["#0868ac", "50% to 75%"],
    ["#070463", "> 75%"]
  ],
  "layerStyles": [
    {
      "id": "est_prop_vb_channel",
      "type": "circle",
      "source": "composite",
      "source-layer": "est_prop_vb_channel",
      "layout": {},
      "paint": {
        "circle-color": [
          "interpolate", ["linear"], ["get", "active_channel_proportion"],
          0, "#ffffff",
          0.000002, "#e5ffcd",
          0.1, "#e5ffcd",
          0.100001, "#99e29d",
          0.25, "#99e29d",
          0.250001, "#7bbbcc",
          0.5, "#7bbbcc",
          0.500001, "#0868ac",
          0.75, "#0868ac",
          0.750001, "#070463",
          2, "#070463"
        ],
        "circle-radius": [
          "interpolate", ["linear"], ["zoom"],
          10, 1.5, 13, 3, 15, 4.5
        ]
      }
    }
  ]
}
