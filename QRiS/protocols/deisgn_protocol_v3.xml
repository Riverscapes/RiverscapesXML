                        </Values>
                    </Visibility>
                    <Values>
                        <Value></Value>
                        <Value>Constriction Jet</Value>
                        <Value>Divergent Flow</Value>
                        <Value>Eddy</Value>
                        <Value>Overflow</Value>
                        <Value>Ponding Flow</Value>
                        <Value>Shunting Flow</Value>
                        <Value>Splitting Flow</Value>
                        <Value>Scour Pool Formation</Value>
                    </Values>
                </ListField>
                <ListField id="zoi_stage" version="1.0">
                    <Label>Stage</Label>
                    <Values allow_custom_values="true">
                        <Value>Baseflow</Value>
                        <Value>Typical Flood</Value>
                        <Value>Large Flood</Value>
                    </Values>
                </ListField>
                <TextField id="notes" version="1.0">
                    <Label>Notes</Label>
                </TextField>
            </Fields>
        </Layer>
        <Layer id="building_materials" version="1.0" geom_type="Polygon">
            <Label>Source Building Materials</Label>
            <Symbology>building_materials_v3.qml</Symbology>
            <Description>Locations that have been determined suitable to source construction material from</Description>
            <Hierarchy>
                <HierarchyItem>Construction Logistics</HierarchyItem>
            </Hierarchy>
            <Fields>
                <ListField id="material_type" version="1.0">
                    <Label>Material Type</Label>
                    <Values allow_multiple_values="true">
                        <Value>Brush</Value>
                        <Value>Downed Wood</Value>
                        <Value>Trees</Value>
                        <Value>Sod</Value>
                        <Value>Rock</Value>
                        <Value>Soil</Value>
                    </Values>
                </ListField>
                <TextField id="notes" version="1.0">
                    <Label>Notes</Label>
                </TextField>
            </Fields>
        </Layer>
        <Layer id="construction" version="1.0" geom_type="Polygon">
            <Label>Limits of Construction</Label>
            <Symbology>construction_v3.qml</Symbology>
            <Description>The extent of the area where construction will occur</Description>
            <Hierarchy>
                <HierarchyItem>Construction Logistics</HierarchyItem>
            </Hierarchy>
            <Fields>
                <TextField id="notes" version="1.0">
                    <Label>Notes</Label>
                </TextField>
            </Fields>
        </Layer>
        <Layer id="disturbance" version="1.0" geom_type="Polygon">
            <Label>Limits of Disturbance</Label>
            <Symbology>disturbance_v3.qml</Symbology>
            <Description>The extent of the area where disturbance will occur, this includes access to the river, staging areas, etc.</Description>
            <Hierarchy>
                <HierarchyItem>Construction Logistics</HierarchyItem>
            </Hierarchy>
            <Fields>
                <TextField id="notes" version="1.0">
                    <Label>Notes</Label>
                </TextField>
            </Fields>
        </Layer>
        <Layer id="staging" version="1.0" geom_type="Polygon">
            <Label>Staging Areas</Label>
            <Symbology>staging_v3.qml</Symbology>
            <Description>Areas where staging materials and equipment will occur</Description>
            <Hierarchy>
                <HierarchyItem>Construction Logistics</HierarchyItem>
            </Hierarchy>
            <Fields>
                <TextField id="notes" version="1.0">
                    <Label>Notes</Label>
                </TextField>
            </Fields>
        </Layer>
        <Layer id="access" version="1.0" geom_type="Linestring">
            <Label>Access Routes</Label>
            <Symbology>access_v3.qml</Symbology>
            <Description>Routes that will be used to access the project areas and staging areas</Description>
            <Hierarchy>
                <HierarchyItem>Construction Logistics</HierarchyItem>
            </Hierarchy>
            <Fields>
                <TextField id="notes" version="1.0">
                    <Label>Notes</Label>
                </TextField>
            </Fields>
        </Layer>
    </Layers>
    <Metrics>
        <Metric id="structure_count" version="1.0" calculation_machine_code="count">
            <Label>Structure Count</Label>
            <DefaultLevel>Metric</DefaultLevel>
            <Description>The number of structures in each sample frame. Structures can be mapped as points and lines, but should not be duplicated.</Description>
            <DefinitionURL/>
            <MinimumValue>0</MinimumValue>
            <Precision>1</Precision>
            <Parameters>
                <DCELayer layer_id_ref="structure_points">
                </DCELayer>
                <DCELayer layer_id_ref="structure_lines">
                </DCELayer>
            </Parameters>
        </Metric>
        <Metric id="structure_density_length" version="1.0" calculation_machine_code="count">
            <Label>Structure Density (Length)</Label>
            <DefaultLevel>Metric</DefaultLevel>
            <Description>The density of structures (points and lines) within the sample frame by riverscape length. Structures can be mapped as points and lines, but should not be duplicated.</Description>            
            <MinimumValue>0</MinimumValue>            
            <Precision>3</Precision>
            <Parameters>
                <InputLayer input_ref="centerline" usage="normalization"/>
                <DCELayer layer_id_ref="structure_points">                    
                </DCELayer>
                <DCELayer layer_id_ref="structure_lines">
                </DCELayer>
            </Parameters>            
        </Metric>
