        <Layer id="complex_zoi" version="1.0" geom_type="Polygon">
            <Label>Complex Zones of Influence</Label>
            <Symbology></Symbology>
            <Description>Zones of Influence at the complex scale</Description>
            <Hierarchy>
                <HierarchyItem>Design Elements</HierarchyItem>
            </Hierarchy>
            <Fields>
                <ListField id="zoi_type_complex"  version="1.0">
                    <Label>ZOI Type</Label>
                    <Values allow_multiple_values="true">
                        <Value>Hydraulic Influence Extent</Value>
                        <Value>Geomorphic Adjustment Extent</Value>
                        <Value>Vegetation Influence Extent</Value>
                    </Values>
                </ListField>
                <ListField id="zoi_stage" version="1.0">
                    <Label>Stage</Label>
                    <Values allow_custom_values="true">
                        <Value>Baseflow</Value>
                        <Value>Typical Flood</Value>
                        <Value>Large Flood</Value>
                    </Values>
                </ListField>
                 <TextField id="notes" version="1.0">
                    <Label>Notes</Label>
                </TextField>
            </Fields>
        </Layer>
        <Layer id="structure_zoi" version="1.0" geom_type="Polygon">
            <Label>Structure Zones of Influence</Label>
            <Symbology>structure_zoi_v3.qml</Symbology>
            <Description>Zones of Influence at the structure scale</Description>
            <Hierarchy>
                <HierarchyItem>Design Elements</HierarchyItem>
            </Hierarchy>
            <Fields>
                <ListField id="zoi_class" version="1.0">
                    <Label>ZOI Class</Label>
                        <Values>
                            <Value>Geomorphic</Value>
                            <Value>Hydraulic</Value>
                        </Values>
                </ListField>
                <ListField id="zoi_type_structure_geomorphic"  version="1.0">
                    <Label>ZOI Type</Label>
                    <Visibility field_id_ref="zoi_class">
                        <Values>
                            <Value>Geomorphic</Value>
                        </Values>
                    </Visibility>
                    <Values>
                        <Value></Value>
                        <Value>Deposition in upstream backwater</Value>
                        <Value>Deposition of bar</Value>
                        <Value>Deposition overbank</Value>
                        <Value>Erode Bank</Value>
                        <Value>Erosion from convergent jet</Value>
                        <Value>Erosion from plunge</Value>
                        <Value>Erosion from return flow headcut</Value>
                        <Value>Erosion of bar edge</Value>
                    </Values>
                </ListField>
                <ListField id="zoi_type_structure_hydraulic"  version="1.0">
                    <Label>ZOI Type</Label>
                    <Visibility field_id_ref="zoi_class">
