<Protocol machine_code="DESIGN_V3" version="1.0" status="experimental"  protocol_type="design" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://xml.riverscapes.net/QRiS/protocol.xsd">
    <Label>LTPBR Design Protocol V3</Label>
    <Description>Design Layers for LTPBR Design V3</Description>
    <URL></URL>
    <Citation>NA</Citation>
    <Author>Josh Gilbert</Author>
    <CreationDate>2026-10-09</CreationDate>
    <UpdatedDate>2026-10-09</UpdatedDate>
    <Layers>
        <Layer id="recovery_space" version="1.0" geom_type="Polygon">
            <Label>Recovery Space</Label>
            <Symbology>recovery_space.qml</Symbology>
            <Description>Recovery Space Layer</Description>
            <MenuItems>
                <MenuItem>copy_from_valley_bottom</MenuItem>
            </MenuItems>
            <Hierarchy>
                <HierarchyItem>Design Elements</HierarchyItem>
            </Hierarchy>
            <Fields>
                <TextField id="notes" version="1.0">
                    <Label>Notes</Label>
                </TextField>
            </Fields>
        </Layer>
        <Layer id="reaches" version="1.0" geom_type="Polygon">
            <Label>Project Sub-Reaches</Label>
            <Symbology>sub_reaches_v3.qml</Symbology>
            <Description>Objectives and conditions of project sub-reaches</Description>
            <Hierarchy>
                <HierarchyItem>Design Elements</HierarchyItem>
            </Hierarchy>
            <Fields>
                <ListField id="primary_objective" version="1.0">
                    <Label>Primary Reach Objective</Label>
                    <Values allow_custom_values="true">
                        <Value>Beaver Translocation</Value>
                        <Value>Incision Recovery</Value>
                        <Value>Increase Channel Complexity</Value>
                        <Value>Increase Floodplain Connectivity</Value>
                        <Value>Lateral Channel Migration</Value>
                        <Value>Overbank Flow Dispersal</Value>
                        <Value>Pond/Wetland Creation</Value>
                        <Value>Riparian/Wetland Expansion</Value>
                        <Value>Side-Channel Connection</Value>
                        <Value>Widening and Aggradation</Value>
                    </Values>
                </ListField>
                <ListField id="secondary_objective" version="1.0">
                    <Label>Secondary Reach Objectives</Label>
                    <Values allow_multiple_values="true">
                        <Value>Beaver Translocation</Value>
                        <Value>Incision Recovery</Value>
                        <Value>Increase Channel Complexity</Value>
                        <Value>Increase Floodplain Connectivity</Value>
                        <Value>Lateral Channel Migration</Value>
                        <Value>Overbank Flow Dispersal</Value>
                        <Value>Pond/Wetland Creation</Value>
                        <Value>Riparian/Wetland Expansion</Value>
                        <Value>Side-Channel Connection</Value>
                        <Value>Widening and Aggradation</Value>
                    </Values>
                </ListField>
                <!-- Restoration objectives are coming from the reach scale text box objectives in the reach sacle NWP maps-->
                <TextField id="restoration_objectives" version="1.0"> 
                    <Label>Objectives Elaborated(Narrative)</Label>
                </TextField>
                <TextField id="reach_condition" version="1.0">
                    <Label>Current Reach Condition</Label>
                </TextField>
                <TextField id="reach_condition_future" version="1.0">
                    <Label>Anticipated Reach Condition</Label>
                </TextField>
                <TextField id="notes" version="1.0">
                    <Label>Notes</Label>
                </TextField>
            </Fields>
        </Layer>
