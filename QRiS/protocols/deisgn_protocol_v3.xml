            </Parameters>            
        </Metric> -->
        <Metric id="treatment_area" version="1.0" calculation_machine_code="area">
            <Label>Treatment Area</Label>
            <DefaultLevel>Metric</DefaultLevel>
            <Description>The total area that will be treated, delineated by "Limits of Construction"</Description>            
            <MinimumValue>0</MinimumValue>            
            <Precision>3</Precision>
            <Parameters>
                <DCELayer layer_id_ref="construction">                    
                </DCELayer>
            </Parameters>            
        </Metric>
        <Metric id="disturbance_area" version="1.0" calculation_machine_code="area">
            <Label>Disturbance Area</Label>
            <DefaultLevel>Metric</DefaultLevel>
            <Description>The total area that will potentially be disturbed through the project area, delineated by "Limits of Disturbance"</Description>            
            <MinimumValue>0</MinimumValue>            
            <Precision>3</Precision>
            <Parameters>
                <DCELayer layer_id_ref="disturbance">                    
                </DCELayer>
            </Parameters>            
        </Metric>
        <Metric id="treatment_proportion" version="1.0" calculation_machine_code="area_proportion">
            <Label>Treatment Proportion of Valley Bottom</Label>
            <DefaultLevel>Metric</DefaultLevel>
            <Description>The tratement area as a ratio of the valley bottom area</Description>            
            <MinimumValue>0</MinimumValue>            
            <Precision>3</Precision>
            <Parameters>
                <InputLayer input_ref="valley_bottom" usage="denominator" />
                <DCELayer layer_id_ref="construction">
                    <Usage>Numerator</Usage>                                    
                </DCELayer>
            </Parameters>            
        </Metric>
        <Metric id="disturbance_proportion" version="1.0" calculation_machine_code="area_proportion">
            <Label>Disturbance Proportion of Valley Bottom</Label>
            <DefaultLevel>Metric</DefaultLevel>
            <Description>The disturbance area as a ratio of the valley bottom area</Description>            
            <MinimumValue>0</MinimumValue>            
            <Precision>3</Precision>
            <Parameters>
                <InputLayer input_ref="valley_bottom" usage="denominator" />
                <DCELayer layer_id_ref="disturbance">
                    <Usage>Numerator</Usage>                                    
                </DCELayer>
            </Parameters>            
        </Metric>
        <Metric id="zoi_area" version="1.0" calculation_machine_code="area">
            <Label>Complex ZOI Area</Label>
            <DefaultLevel>Metric</DefaultLevel>
            <Description>The total area of complex ZOIs</Description>            
            <MinimumValue>0</MinimumValue>            
            <Precision>3</Precision>
            <Parameters>
                <DCELayer layer_id_ref="complex_zoi">
                    <Usage>Numerator</Usage>                                    
                </DCELayer>
            </Parameters>            
        </Metric>
        <Metric id="zoi_proportion_recovery" version="1.0" calculation_machine_code="area_proportion">
            <Label>ZOI Proportion of Recovery Space</Label>
            <DefaultLevel>Metric</DefaultLevel>
            <Description>The ZOI area as a ratio of the recovery space</Description>            
            <MinimumValue>0</MinimumValue>            
            <Precision>3</Precision>
            <Parameters>
                <DCELayer layer_id_ref="complex_zoi">
                    <Usage>Numerator</Usage>                                    
                </DCELayer>
                <DCELayer layer_id_ref="recovery_space">
                    <Usage>Denominator</Usage>
                </DCELayer>
            </Parameters>            
        </Metric>
        <Metric id="zoi_proportion_valley" version="1.0" calculation_machine_code="area_proportion">
            <Label>ZOI Proportion of Valley Bottom</Label>
            <DefaultLevel>Metric</DefaultLevel>
            <Description>The ZOI area as a ratio of the valley bottom</Description>            
            <MinimumValue>0</MinimumValue>            
            <Precision>3</Precision>
            <Parameters>
                <InputLayer input_ref="valley_bottom" usage="denominator" />
                <DCELayer layer_id_ref="complex_zoi">
                    <Usage>Numerator</Usage>                                    
                </DCELayer>
            </Parameters>            
        </Metric>
    </Metrics>
</Protocol>

